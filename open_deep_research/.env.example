# ============================================
# REQUIRED - Add your API keys here
# ============================================

# OpenAI API Key (required for default models)
OPENAI_API_KEY=

# Configure Search API (arxiv = academic papers only, tavily = web search, none = no search)
SEARCH_API=arxiv

# ============================================
# OPTIONAL - Only if needed
# ============================================

# LangSmith (optional - for tracing/debugging)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Alternative LLM providers (optional)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Tavily Search API (optional - for web search functionality)
TAVILY_API_KEY=

# ============================================
# PRODUCTION DEPLOYMENT - Open Agent Platform
# ============================================

# Supabase Configuration (only needed for production deployment)
# When these are NOT set, the system runs in local development mode
# with authentication disabled for easier testing.
SUPABASE_URL=
SUPABASE_KEY=

# Set to true when deployed on Open Agent Platform (production)
# Set to false for local development
GET_API_KEYS_FROM_CONFIG=false
