# ============================================
# REQUIRED - Add your API keys here
# ============================================

# OpenAI API Key (required)
OPENAI_API_KEY=

# Configure Search API
# Options: arxiv (academic papers only), semantic_scholar (200M+ papers, all disciplines), openai (native web search), none (no search)
SEARCH_API=arxiv

# ============================================
# OPTIONAL - Only if needed
# ============================================

# Semantic Scholar API Key (optional - for higher rate limits)
# Without key: Shared rate limit (100 requests per 5 minutes)
# With key: 1 request per second guaranteed
# Get your key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# LangSmith (optional - for tracing/debugging)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-compass-core
LANGSMITH_TRACING=false

# ============================================
# CONFIGURATION
# ============================================

# Set to false for local development (default)
# Set to true only for production deployment
GET_API_KEYS_FROM_CONFIG=false
